{
  "schemaVersion": 1,
  "id": "fabricord",
  "version": "${version}",
  "name": "Fabricord",
  "description": "A modern message style like DiscordSRV will be reproduced as a Fabric version mod.",
  "contributors": [
    "RiriFa"
  ],
  "contact": {
    "sources": "https://github.com/ririf4/Fabricord",
    "issues": "https://github.com/ririf4/Fabricord/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/fabricord/icon.png",
  "environment": "server",
  "entrypoints": {
    "server": [
      {
        "adapter": "kotlin",
        "value": "net.ririfa.fabricord.Fabricord"
      }
    ]
  },
  "mixins": [
    "fabricord.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">1.19 <=1.19.2",
    "java": ">=17",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-message-api-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-language-kotlin": ">=1.13.10+kotlin.2.3.20"
  }
}
