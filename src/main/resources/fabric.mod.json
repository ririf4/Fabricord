{
	"schemaVersion": 1,
	"id": "fabricord",
	"version": "${version}",
	"name": "Fabricord",
	"description": "A modern message style like DiscordSRV will be reproduced as a Fabric version mod.",
	"contributors": [
		"RiriFa"
	],
	"contact": {
		"sources": "https://github.com/ririf4/Fabricord",
		"issues": "https://github.com/ririf4/Fabricord/issues"
	},
	"license": "Apache-2.0",
	"icon": "assets/fabricord/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
			{
				"adapter": "kotlin",
				"value": "net.ririfa.fabricord.Fabricord"
			}
		]
	},
	"mixins": [
		"fabricord.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": "1.20.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.1+kotlin.2.1.10"
	},
	"accessWidener": "fabricord.accesswidener"
}